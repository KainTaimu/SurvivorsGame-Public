[sub_resource type="GDScript" id="GDScript_yvf4j"]
script/source = "extends Node


func _ready() -> void:
	Console.pause_enabled = true
	Console.add_command(\"god\", _toggle_god)


func _toggle_god():
	var stats := GameWorldInstance.MainPlayer.Character.CharacterStats as CharacterStats
	var god: bool = stats.get(\"_godMode\")
	stats.set(\"_godMode\", !god)
	CustomLogger.log_info(\"god: %s\" % !god)
"

