[sub_resource type="GDScript" id="GDScript_do71q"]
script/source = "extends Button

func _on_button_up() -> void:
	var player := GameWorldInstance.MainPlayer as Player
	var wpn_ctrlr := player.WeaponController as Node
	for child in wpn_ctrlr.get_children():
		child.queue_free()
"

[sub_resource type="GDScript" id="GDScript_ogoab"]
script/source = "extends CanvasLayer

@export var fps_label: Label


func _ready() -> void:
	if !OS.has_feature(\"prod\"):
		queue_free()


func update() -> void:
	fps_label.text = \"FPS: %s\" % roundi(Performance.get_monitor(Performance.TIME_FPS))
"

