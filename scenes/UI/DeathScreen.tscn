[sub_resource type="GDScript" id="GDScript_vh4wb"]
script/source = "extends ColorRect


func _on_death_screen_show() -> void:
	modulate = Color.TRANSPARENT
	var tween := create_tween()
	tween.tween_property(self, \"modulate\", Color.WHITE, 3.0)
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_cat5s"]
shader = ExtResource("2_fiwl2")
shader_parameter/amount = 0.0

[sub_resource type="GDScript" id="GDScript_cat5s"]
script/source = "extends ColorRect

@export var final_blur_amount: float = 1.4
@export var time_to_final_blur: float = 3
var started: bool
var blur_time: float
var blur_amount: float
@onready var shader_material := material as ShaderMaterial


func _process(delta: float) -> void:
	if not started or time_to_final_blur <= 0:
		return
	blur_time = max(0, blur_time - delta)
	blur_amount = lerpf(0, final_blur_amount, (time_to_final_blur - blur_time) / time_to_final_blur)
	shader_material.set_shader_parameter(&\"amount\", blur_amount)


func start_blurring():
	started = true
	blur_time = time_to_final_blur
	blur_amount = 0
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_do71q"]
