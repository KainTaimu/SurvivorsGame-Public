[sub_resource type="GDScript" id="GDScript_ogoab"]
script/source = "extends Button

@export var timeout_seconds = 2.0

var click_count: int:
	get:
		return click_count
	set(value):
		click_count = value
		match click_count:
			0:
				text = \"Quit\"
			1:
				text = \"Confirm quit\"
var last_click: float
var secs_until_timeout: float


func _process(delta: float) -> void:
	if secs_until_timeout <= 0:
		click_count = 0
		return
	secs_until_timeout -= delta


func on_click() -> void:
	click_count += 1
	secs_until_timeout = timeout_seconds
	if click_count == 2:
		quit_game()


func quit_game() -> void:
	get_tree().quit()
"

