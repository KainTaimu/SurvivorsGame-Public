[sub_resource type="GDScript" id="GDScript_do71q"]
script/source = "extends Label

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	var actions := InputMap.get_actions()
	for action in actions:
		if action.begins_with(\"ui_\"):
			continue
		var events := InputMap.action_get_events(action)
		var event := events[0]
		
		if event is InputEventKey:
			var key := events[0] as InputEventKey
			text = \"%s\\n%s = %s\" % [text, action, key.as_text_physical_keycode()]
		elif event is InputEventMouseButton:
			var btn := events[0] as InputEventMouseButton
			text = \"%s\\n%s = %s\" % [text, action, btn.as_text()]
"

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_do71q"]

[sub_resource type="GDScript" id="GDScript_ogoab"]
script/source = "extends Button

@export var timeout_seconds = 2.0

var click_count: int:
	get:
		return click_count
	set(value):
		click_count = value
		match click_count:
			0:
				text = \"Quit\"
			1:
				text = \"Confirm quit\"
var last_click: float
var secs_until_timeout: float


func _process(delta: float) -> void:
	if secs_until_timeout <= 0:
		click_count = 0
		return
	secs_until_timeout -= delta


func on_click() -> void:
	click_count += 1
	secs_until_timeout = timeout_seconds
	if click_count == 2:
		quit_game()


func quit_game() -> void:
	get_tree().quit()
"

