[sub_resource type="GDScript" id="GDScript_bplp6"]
script/source = "extends CanvasLayer

@onready var playerStats: CharacterStatsAccessor = CharacterStatsAccessor.new()
@onready var wave_controller: EnemyWaveControllerAccessor = EnemyWaveControllerAccessor.new()

@export var healthBar: ProgressBar
@export var moneyLabel: Label
@export var enemies_alive_label: Label

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	healthBar.value = playerStats.Health / float(playerStats.MaxHealth)
	moneyLabel.text = \"$%s\" % str(GameWorldInstance.LevelData.Money)
	enemies_alive_label.text = \"Enemies: %s\" % wave_controller.AliveEnemies
"

