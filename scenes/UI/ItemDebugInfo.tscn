[sub_resource type="CSharpScript" id="CSharpScript_tmfea"]
script/source = "// Copyright 2026 Erwin Panergo
// SPDX-License-Identifier: GPL-3.0-or-later

using System.Reflection;
using System.Text;
using Game.Players.Controllers;
using Node = Godot.Node;

namespace Game.Utils;

public partial class ItemDebugInfo : CanvasLayer
{
	[Export]
	public bool Enabled
	{
		get;
		set
		{
			field = value;
			Visible = field;
		}
	}

	[Export]
	public Node? Target;

	[Export]
	public AbstractPlayerItemController? PlayerItemController;

	[Export]
	public Label Label = null!;

	[Export]
	public int RecursionDepth;

	public override void _Ready()
	{
		Visible = Enabled;
	}

	public override void _Process(double delta)
	{
		if (!Enabled)
			return;

		var target = Target ?? PlayerItemController?.Equipped;
		if (target is null)
		{
			Hide();
			return;
		}

		if (!Visible)
			Show();

		var s = new StringBuilder();
		s.AppendLine(
			ClassInspector.GetClassFieldsString(target, BindingFlags.NonPublic | BindingFlags.Instance, RecursionDepth)
		);
		s.AppendLine(
			ClassInspector.GetClassPropertiesString(
				target,
				BindingFlags.NonPublic | BindingFlags.Instance,
				RecursionDepth
			)
		);
		Label.Text = s.ToString();
	}
}
"

